<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <a href="/" style="position: absolute; top: 30px; left: 30px;">
        <button>Go Back</button>
    </a>

    <div class="card">
        <h1>The decision is: <%= decision ? "Yes" : "No" %></h1>

        <% if (decision) { %>
            <p><strong>Generated number:</strong> <%= number || "-" %></p>
            <p><strong>Generated date:</strong> <%= formattedDate || "-" %></p>
        <% } %>
    </div>
</body>
</html>