<!DOCTYPE html>
<html>
    <head>
          <link rel="stylesheet" href="/style.css">
    <body>
        <div class="card">
        <h1>The decision is: <%= decision ? "Yes" : "No" %></h1>

        <% if (decision) { %>
            <p><strong>Generated number:</strong> <%= number || "-" %></p>
            <p><strong>Generated date:</strong> <%= formattedDate || "-" %></p>
        <% } %>
        </div>
    </body>
    </head>
</html>